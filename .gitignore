# --- Data: BNIntent30 has no license (docs/PROTOCOL.md §3.4). No text, raw or cleaned,
# is ever committed. Only the split manifests (uids + sha256) are tracked.
data/*
!data/splits/
data/splits/*
!data/splits/manifest.json
!data/splits_dirty/
data/splits_dirty/*
!data/splits_dirty/manifest.json
# §12 extension (es, hi): translations, split files and caches stay local; only the
# split manifest (uids + sha256, no text) is tracked.
!data/extension/
data/extension/*
!data/extension/splits/
data/extension/splits/*
!data/extension/splits/manifest.json

# --- Environment / tooling
.venv/
__pycache__/
*.pyc
.pytest_cache/
logs/

# --- Manuscript drafts: not committed yet (they also quote dataset text)
docs/drafts/

# --- Journal manuscript (LaTeX): not committed
paper/
